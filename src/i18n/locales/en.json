    "suggestions": {
      "deepseek": [
        "The scene opens well. Add detail through action — not description.",
        "The dialogue works, but the second line explains what the audience already understood. Cut it.",
        "Start in the middle — throw the viewer into action without a preamble."
      ],
      "claude": [
        "The character lacks a clear want in this scene. What do they want?",
        "Act two sags. You need a turn — the moment the plan falls apart.",
        "The dialogue sounds written. Read it aloud — you'll hear where the rhythm stumbles."
      ],
      "gpt": [
        "What if the scene isn't in a café, but in a place that is a metaphor on its own?",
        "What if Marina is writing a letter? The recipient is unknown. That changes everything.",
        "What if the rain outside the window is a character? It says something to her. What exactly?"
      ],
      "grok": [
        "Try shifting the focus: not what happened, but what the hero is hiding.",
        "Make the conflict sharper in the very first line.",
        "Check whether you can cut the scene by a third without losing meaning."
      ],
      "gemini": [
        "Break the scene into goal, obstacle, and turn.",
        "Think where the sharpest image belongs instead of explanation.",
        "Try a version where subtext matters more than the literal meaning."
      ]
    }
  },
