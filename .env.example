# Backend origin only (scheme+host+port). No trailing slash; do not append `/api` (paths already include `/api/...`). If unset, dev proxies `/api` — see README.
VITE_API_URL=http://127.0.0.1:8080

# When VITE_API_URL is empty: proxy `/api` to this origin during `npm run dev` (host only).
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Vite `base` + React Router basename (e.g. `/OldWhale/` for GitHub Pages project site)
VITE_BASE_PATH=/
